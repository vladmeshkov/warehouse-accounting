# ─────────────────────────────────────────────────────────────────
#  Warehouse Server — Dockerfile
#  Сборка: docker build -f Dockerfile.server -t warehouse-server .
# ─────────────────────────────────────────────────────────────────

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Копируем собранный JAR (после mvn package)
COPY server/target/warehouse-server.jar app.jar

# Порт сервера
EXPOSE 8888

ENTRYPOINT ["java", "-jar", "app.jar"]
