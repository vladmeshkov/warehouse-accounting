<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="by.bsuir.warehouse.client.controller.LoginController"
      alignment="CENTER" spacing="16"
      style="-fx-background-color: #f4f6fb;">

    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

    <!-- Заголовок -->
    <Label text="Складской учёт" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Вход в систему" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

    <!-- Форма -->
    <VBox spacing="8">
        <Label text="Логин" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
        <TextField fx:id="usernameField" promptText="Введите логин"
                   style="-fx-pref-height: 36px; -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Пароль" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
        <PasswordField fx:id="passwordField" promptText="Введите пароль"
                       style="-fx-pref-height: 36px; -fx-font-size: 13px;"/>
    </VBox>

    <!-- Адрес сервера -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Сервер:" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
        <TextField fx:id="hostField" promptText="localhost"
                   prefWidth="130"
                   style="-fx-font-size: 11px; -fx-pref-height: 28px;"/>
        <Label text=":" style="-fx-font-size: 11px; -fx-text-fill: #999;"/>
        <TextField fx:id="portField" promptText="8888"
                   prefWidth="60"
                   style="-fx-font-size: 11px; -fx-pref-height: 28px;"/>
    </HBox>

    <!-- Сообщение об ошибке -->
    <Label fx:id="errorLabel" text=""
           style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"
           wrapText="true"/>

    <!-- Кнопка входа -->
    <Button fx:id="loginButton" text="Войти"
            onAction="#handleLogin"
            defaultButton="true"
            maxWidth="Infinity"
            style="-fx-background-color: #2980b9; -fx-text-fill: white;
                   -fx-font-size: 14px; -fx-pref-height: 40px;
                   -fx-cursor: hand; -fx-background-radius: 5;"/>

</VBox>
