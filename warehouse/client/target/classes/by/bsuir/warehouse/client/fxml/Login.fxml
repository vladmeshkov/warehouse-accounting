<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="by.bsuir.warehouse.client.controller.LoginController"
           styleClass="root"
           stylesheets="@../css/login-style.css">
    <VBox styleClass="card" alignment="CENTER" spacing="16">
        <VBox spacing="6" alignment="CENTER">
            <Label text="📦 Складской учёт" styleClass="title"/>
            <Label text="Войдите в свою учётную запись" styleClass="subtitle"/>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label text="Логин" styleClass="input-label"/>
            <TextField fx:id="usernameField" promptText="Введите логин" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label text="Пароль" styleClass="input-label"/>
            <PasswordField fx:id="passwordField" promptText="Введите пароль" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true"/>

        <Button fx:id="loginButton" text="Войти" onAction="#handleLogin"
                styleClass="button-primary" maxWidth="Infinity" defaultButton="true"/>

        <Hyperlink text="Зарегистрироваться" onAction="#openRegisterWindow" styleClass="hyperlink"/>
    </VBox>
</StackPane>