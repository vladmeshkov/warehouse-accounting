<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="by.bsuir.warehouse.client.controller.DashboardController"
      spacing="20" style="-fx-background-color: #f4f6fb;">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Главная" styleClass="section-title"/>
    <Label fx:id="subtitleLabel" text="" style="-fx-text-fill: #7f8c8d;"/>

    <!-- Карточки статистики -->
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Товарных позиций" styleClass="stat-label"/>
            <Label fx:id="productCountLabel" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Складов" styleClass="stat-label"/>
            <Label fx:id="warehouseCountLabel" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Критических позиций" styleClass="stat-label"/>
            <Label fx:id="criticalCountLabel" text="—" styleClass="stat-value"
                   style="-fx-text-fill: #e74c3c;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="Документов сегодня" styleClass="stat-label"/>
            <Label fx:id="docsTodayLabel" text="—" styleClass="stat-value"
                   style="-fx-text-fill: #27ae60;"/>
        </VBox>
    </HBox>

    <!-- Критические позиции -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="⚠  Критические остатки (дефицит ≤ 7 дней)"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            <Button text="Обновить" onAction="#refresh"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                           -fx-background-radius: 4; -fx-padding: 4 12 4 12; -fx-cursor: hand;"/>
        </HBox>

        <TableView fx:id="criticalTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colWarehouse" text="Склад"       prefWidth="160"/>
                <TableColumn fx:id="colArticle"   text="Артикул"     prefWidth="100"/>
                <TableColumn fx:id="colProduct"   text="Товар"       prefWidth="220"/>
                <TableColumn fx:id="colStock"     text="Остаток"     prefWidth="90"/>
                <TableColumn fx:id="colMin"       text="Минимум"     prefWidth="90"/>
                <TableColumn fx:id="colDays"      text="Дней до дефицита" prefWidth="140"/>
                <TableColumn fx:id="colDate"      text="Дата дефицита"    prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
